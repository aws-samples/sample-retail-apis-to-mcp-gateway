<mxfile host="Electron" pages="1">
  <diagram id="demo3-after" name="After">
    <mxGraphModel dx="1100" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="Demo 3 - Scoped identity: the same call, allowed or blocked at the boundary" style="text;html=1;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="960" height="30" as="geometry" />
        </mxCell>
        <!-- AWS Cloud group (drawn first so it sits behind the icons) -->
        <mxCell id="awscloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#AAB7B8;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingTop=5;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="1200" height="660" as="geometry" />
        </mxCell>
        <!-- Agent: customer service representative (green) -->
        <mxCell id="representative" value="Agent: customer service representative&#xa;scopes: refunds/invoke&#xa;refunds/refund:create" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="280" height="80" as="geometry" />
        </mxCell>
        <!-- Agent: customer (red) -->
        <mxCell id="customer" value="Agent: customer&#xa;scope: refunds/invoke&#xa;(no refunds/refund:create)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="280" height="80" as="geometry" />
        </mxCell>
        <!-- Amazon Cognito (Security, Identity - red) -->
        <mxCell id="cognito" value="Amazon Cognito&#xa;(issues scoped JWT)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="560" y="410" width="60" height="60" as="geometry" />
        </mxCell>
        <!-- AgentCore Gateway + Cedar (Bedrock icon - teal) -->
        <mxCell id="gateway" value="AgentCore Gateway&#xa;+ Cedar policy engine (ENFORCE)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="900" y="410" width="60" height="60" as="geometry" />
        </mxCell>
        <!-- AWS Lambda (Compute - orange) - refund tool -->
        <mxCell id="lambda" value="AWS Lambda&#xa;(refund tool)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1450" y="240" width="60" height="60" as="geometry" />
        </mxCell>
        <!-- DENIED (structured error) -->
        <mxCell id="denied" value="DENIED at the gateway&#xa;start_refund is not listed for the customer; a call is denied before reaching the backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="540" width="260" height="110" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="d0" value="1. request token&#xa;(+refund:create)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.05;entryDx=0;entryDy=0;" edge="1" parent="1" source="representative" target="cognito"><mxGeometry x="-0.1" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d1" value="1. request token&#xa;(no refund:create)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="customer" target="cognito"><mxGeometry x="0.6" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d2" value="2. MCP call (Bearer JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="representative" target="gateway"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d2b" value="2. MCP call (Bearer JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="customer" target="gateway"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="600" /><mxPoint x="780" y="455" /></Array></mxGeometry></mxCell>
        <mxCell id="d5" value="3. validate JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#666666;dashed=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d3" value="4. refund:create in scope -&gt; ALLOW" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="d4" value="4. no matching permit -&gt; DENY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="denied"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        </root>
